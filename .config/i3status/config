# i3status configuration file for arch-2
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}

# order += "ipv6"
order += "wireless _first_"
#order += "ethernet _first_"
#order += "load"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "volume master"
#order += "battery all"
order += "tztime local"
#order += "exec custom_brightness"

wireless _first_ {
        format_up = ""
        format_down = "Wifi down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
	format_percentage = "%.00f%s"
}
#🔋

disk "/" {
        format = "%avail"
}
cpu_usage {
	format = " %usage"
}

load {
        format = " %1min"
	separator = false
}

memory {
        format = "%percentage_used"
        threshold_degraded = "1G"
        format_degraded = "MEM LOW %percentage_used"
}

tztime local {
        #format = "󰃭 %d-%m-%Y %H:%M"
        format = " %H:%M"
}
#🕒♪
volume master {
        format = "󰕾 %volume"
        format_muted = "󰝟 %volume"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

