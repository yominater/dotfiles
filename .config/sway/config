# Sway config for arch-2
set $mod Mod1
set $win Mod4
set $exec-once exec --no-startup-id
set $volume_limit 155
set $terminal terminator --profile=sway2
set $browser firefox &
set $obsidian ~/apps/Obsidian*.AppImage

# colors
set $background #000000

# display external
output HDMI-A-1 pos 0 0 res 1920x1080 scale 1 
#output * bg ~/images/wallpapers/Sunset.jpg fill
output * bg $background solid_color

# Keyboard
input "type:keyboard" {
    repeat_delay 200
    repeat_rate 32
    xkb_options caps:escape
    pointer_accel 0.3
}

# Set theme
seat * xcursor_theme BreezeX-Black 30
exec --no-startup-id export XDG_CURRENT_DESKTOP=Cinnamon
exec --no-startup-id export GTK_THEME=Adwaita:dark  # Or your preferred theme

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:DejaVu Sans Mono 8

# AUTOSTART SECTION **********************************

# Keybinds *******************************************

# Right click to win + left click
bindsym --release Mod4+button1 button3

